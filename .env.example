# Dodo Payments — copy your keys here (test or live)
DODO_ENVIRONMENT=test
DODO_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
DODO_PRODUCT_ID=prod_xxxxxxxx
DODO_WEBHOOK_SECRET=whsec_xxxxxxxx

# Public base URL used for Dodo return/cancel redirects + webhook
# For local testing: run `ngrok http 3000` and paste the https URL (e.g. https://abc123.ngrok.app)
PUBLIC_BASE_URL=http://localhost:3000

# Cloudinary — logos are only pushed to Cloudinary AFTER payment succeeds
# Get these from Cloudinary Dashboard > Account settings (or the API Key/Secret page)
CLOUDINARY_CLOUD_NAME=kuajp0qg
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Supabase Postgres via Prisma
# v7 uses a single url (set the session-mode pooler port 5432 so migrations work)
DATABASE_URL="postgresql://<project>.pooler.supabase.com:5432/postgres"